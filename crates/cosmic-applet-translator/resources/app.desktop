[Desktop Entry]
Name=Screen Translator
Comment=Real-time Screen and Game Translator for COSMIC
Type=Application
Icon=com.system76.CosmicExtLingua
Exec=cosmic-applet-translator --applet %F
Terminal=false
StartupNotify=true
Categories=COSMIC
Keywords=COSMIC;translator;game;ocr;
NoDisplay=false
X-CosmicApplet=true
X-CosmicHoverPopup=Auto
