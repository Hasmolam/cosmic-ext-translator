[Desktop Entry]
Name=Screen Translator
Comment=Real-time Screen and Game Translator for COSMIC
Type=Application
Icon=io.github.hasmolam.CosmicExtTranslator
Exec=cosmic-applet-translator --applet
Terminal=false
StartupNotify=true
Categories=Utility;X-COSMIC;
Keywords=translate;translator;screen;game;cosmic;ocr;
NoDisplay=false
X-CosmicApplet=true
X-CosmicHoverPopup=Auto
